---
import Layout from '../layouts/Layout.astro';

const teamMembers = [
  {
    name: "Sarah Chen",
    role: "Lead Beauty Editor & Licensed Cosmetologist",
    credentials: "Licensed Cosmetologist (CA State Board), 12+ years professional experience",
    specialties: ["Hair Coloring", "Skincare", "Trend Forecasting"],
    bio: "Sarah has worked with top salons in Los Angeles and New York, and her work has been featured in Allure, InStyle, and Cosmopolitan. She specializes in translating runway beauty trends into practical, everyday guidance.",
    photo: "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=400&h=400&q=85"
  },
  {
    name: "Marcus Rivera",
    role: "Men's Grooming Expert & Master Barber",
    credentials: "Master Barber License, Andis Educator, 9+ years barbershop experience",
    specialties: ["Fade Techniques", "Beard Styling", "Men's Hair Care"],
    bio: "Marcus trained at the prestigious Barber School of New York and has competed in national barbering championships. He brings real chair-side expertise to every men's grooming guide on our site.",
    photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&h=400&q=85"
  },
  {
    name: "Priya Nair",
    role: "Nail Art Specialist & Certified Nail Technician",
    credentials: "CND Shellac Certified, Nail Tech License (TX State Board), 7+ years experience",
    specialties: ["Nail Art", "Gel Extensions", "Press-On Nails"],
    bio: "Priya's nail artistry has been showcased at New York Fashion Week and featured on NailPro Magazine. She reviews every nail product and technique we publish for accuracy and safety.",
    photo: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=400&h=400&q=85"
  }
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "BeautyTrend Daily",
  "url": "https://beautytrend-daily.pages.dev",
  "description": "Expert beauty and grooming guides written and reviewed by licensed cosmetologists, master barbers, and certified nail technicians.",
  "foundingDate": "2024",
  "areaServed": "Worldwide",
  "employee": teamMembers.map(m => ({
    "@type": "Person",
    "name": m.name,
    "jobTitle": m.role,
    "description": m.bio
  }))
};
---

<Layout title="About BeautyTrend Daily | Our Expert Editorial Team" description="Meet the licensed beauty professionals, cosmetologists, and style experts behind BeautyTrend Daily's trusted beauty and grooming guides.">
  <main class="about-page">
    <section class="about-hero">
      <div class="container">
        <h1>About BeautyTrend Daily</h1>
        <p class="hero-subtitle">Expert Beauty Guidance You Can Trust — Written & Reviewed by Licensed Professionals</p>
      </div>
    </section>

    <section class="mission-section">
      <div class="container">
        <h2>Our Mission</h2>
        <p>BeautyTrend Daily was founded with one purpose: to provide accurate, expert-backed beauty and grooming guidance that actually works in real life. Every article on our site is written or reviewed by a licensed cosmetologist, master barber, or certified nail technician — not just content writers.</p>
        <p>We cover everything from the latest 2026 haircut trends to nail art techniques, skincare routines, and men's grooming — all backed by professional expertise and first-hand salon experience.</p>
      </div>
    </section>

    <section class="editorial-standards">
      <div class="container">
        <h2>Our Editorial Standards & Review Process</h2>
        <div class="standards-grid">
          <div class="standard-card">
            <div class="standard-icon">✍️</div>
            <h3>Expert-Written Content</h3>
            <p>All articles are written by or in direct collaboration with licensed beauty professionals with verified credentials.</p>
          </div>
          <div class="standard-card">
            <div class="standard-icon">🔍</div>
            <h3>Professional Review</h3>
            <p>Every technique and product recommendation is reviewed by a licensed professional before publication for accuracy and safety.</p>
          </div>
          <div class="standard-card">
            <div class="standard-icon">📅</div>
            <h3>Regular Updates</h3>
            <p>We update our guides quarterly to reflect the latest trends, products, and professional standards in the beauty industry.</p>
          </div>
          <div class="standard-card">
            <div class="standard-icon">🏆</div>
            <h3>First-Hand Experience</h3>
            <p>Our experts draw on years of real salon and barbershop experience — not just research — to provide practical, tested advice.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="team-section">
      <div class="container">
        <h2>Meet Our Expert Team</h2>
        <div class="team-grid">
          {teamMembers.map(member => (
            <article class="team-card" itemscope itemtype="https://schema.org/Person">
              <div class="team-photo-wrapper">
                <img
                  src={member.photo}
                  alt={`${member.name} - ${member.role}`}
                  class="team-photo"
                  itemprop="image"
                  width="200"
                  height="200"
                />
              </div>
              <div class="team-info">
                <h3 itemprop="name">{member.name}</h3>
                <p class="team-role" itemprop="jobTitle">{member.role}</p>
                <p class="team-credentials">🏅 {member.credentials}</p>
                <p class="team-bio" itemprop="description">{member.bio}</p>
                <div class="team-specialties">
                  <strong>Specialties:</strong>
                  <ul>
                    {member.specialties.map(s => <li>{s}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="trust-section">
      <div class="container">
        <h2>Why Trust BeautyTrend Daily?</h2>
        <ul class="trust-list">
          <li>✅ All beauty and health claims are reviewed by licensed professionals</li>
          <li>✅ We follow YMYL (Your Money, Your Life) content standards</li>
          <li>✅ No sponsored content influences our editorial recommendations</li>
          <li>✅ Product mentions are based on professional testing and industry standards</li>
          <li>✅ We cite professional sources including Allure, NailPro, American Board of Certified Haircolorists</li>
        </ul>
        <p class="contact-note">Questions about our content? Contact us at <strong>editorial@beautytrend-daily.com</strong></p>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
  </main>
</Layout>

<style>
.about-page { font-family: system-ui, sans-serif; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
.about-hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color: white; padding: 5rem 0 4rem; text-align: center; }
.about-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 1rem; }
.hero-subtitle { font-size: 1.2rem; opacity: 0.85; max-width: 600px; margin: 0 auto; }
.mission-section { padding: 4rem 0; background: #fafafa; }
.mission-section h2 { font-size: 2rem; margin-bottom: 1.5rem; color: #1a1a2e; }
.mission-section p { font-size: 1.1rem; line-height: 1.8; color: #444; margin-bottom: 1rem; }
.editorial-standards { padding: 4rem 0; background: white; }
.editorial-standards h2 { font-size: 2rem; margin-bottom: 2rem; color: #1a1a2e; text-align: center; }
.standards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
.standard-card { background: #f8f9ff; border-radius: 12px; padding: 1.5rem; text-align: center; border: 1px solid #e0e4ff; }
.standard-icon { font-size: 2rem; margin-bottom: 0.75rem; }
.standard-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #1a1a2e; }
.standard-card p { font-size: 0.9rem; color: #555; line-height: 1.6; }
.team-section { padding: 4rem 0; background: #fafafa; }
.team-section h2 { font-size: 2rem; margin-bottom: 2.5rem; color: #1a1a2e; text-align: center; }
.team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
.team-card { background: white; border-radius: 16px; padding: 2rem; display: flex; gap: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); align-items: flex-start; }
.team-photo { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; }
.team-photo-wrapper { flex-shrink: 0; }
.team-info h3 { font-size: 1.2rem; margin: 0 0 0.3rem; color: #1a1a2e; }
.team-role { font-size: 0.85rem; color: #6366f1; font-weight: 600; margin-bottom: 0.4rem; }
.team-credentials { font-size: 0.8rem; color: #555; margin-bottom: 0.75rem; background: #f0f0ff; padding: 0.3rem 0.5rem; border-radius: 6px; }
.team-bio { font-size: 0.9rem; color: #444; line-height: 1.6; margin-bottom: 0.75rem; }
.team-specialties { font-size: 0.85rem; color: #333; }
.team-specialties ul { margin: 0.25rem 0 0; padding-left: 1.2rem; }
.trust-section { padding: 4rem 0; background: #1a1a2e; color: white; }
.trust-section h2 { font-size: 2rem; margin-bottom: 1.5rem; color: white; }
.trust-list { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
.trust-list li { font-size: 1rem; line-height: 1.5; }
.contact-note { margin-top: 2rem; font-size: 0.95rem; opacity: 0.8; }
</style>
