---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: {
      slug: article.id.replace(/\.md$/, ''),
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection('articles');
const slug = article.id.replace(/\.md$/, '');
const siteUrl = 'https://beautytrend-daily.pages.dev';
const canonicalUrl = `${siteUrl}/articles/${slug}/`;

const {
  title,
  description,
  excerpt,
  category,
  keywords = [],
  publishedAt,
  updatedAt,
  heroImage,
  imageCredit,
  youtube = [],
  faq = [],
} = article.data;

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const categorySlug = (category || 'beauty-trends')
  .toLowerCase()
  .replace(/\s+/g, '-');

// Uniform High-Resolution Featured Cover Photo
const featuredImage =
  heroImage ||
  'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=1200&h=675&q=85';

// Related articles from same category
const relatedArticles = allArticles
  .filter((a) => a.id !== article.id && a.data.category === category)
  .slice(0, 2);

// Calculate approx word count & reading time
const bodyText = article.body || '';
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readingTimeMin = Math.max(3, Math.ceil(wordCount / 220));

// Schema.org Article Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: [featuredImage],
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt
    ? new Date(updatedAt).toISOString()
    : new Date(publishedAt).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily Editorial',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily',
    url: siteUrl,
  },
  articleSection: category,
  keywords: (keywords || []).join(', '),
  wordCount,
};

// Schema.org FAQ Data
const faqSchema =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf8f7" />

    <title>{title} | BeautyTrend Daily</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="BeautyTrend Daily" />
    <meta property="og:image" content={featuredImage} />
    <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />
    <meta property="article:section" content={category} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={featuredImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <style>
      :global(*) { box-sizing: border-box; }
      body {
        margin: 0;
        background: #faf8f7;
        color: #202020;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.8;
      }
      .site-header {
        border-bottom: 1px solid #eeeeee;
        background: #ffffff;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .header-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        color: #111111;
        text-decoration: none;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }
      .logo span { color: #d65d7a; }
      .back-link {
        color: #666;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }
      .back-link:hover { color: #d65d7a; }

      .article-wrapper {
        max-width: 840px;
        margin: 0 auto;
        padding: 40px 20px 80px;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        margin-top: 30px;
        margin-bottom: 50px;
      }

      .category-pill {
        display: inline-block;
        margin-bottom: 16px;
        padding: 6px 14px;
        border-radius: 999px;
        background: #fdf0f3;
        color: #d65d7a;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
      }
      .category-pill:hover { background: #fce1e7; }

      h1 {
        margin: 0 0 16px;
        color: #111111;
        font-size: clamp(30px, 5vw, 44px);
        line-height: 1.15;
        letter-spacing: -1px;
      }

      .excerpt {
        margin: 0 0 20px;
        color: #555555;
        font-size: 18px;
        line-height: 1.6;
        font-weight: 400;
      }

      .meta {
        padding-bottom: 22px;
        margin-bottom: 28px;
        border-bottom: 1px solid #eeeeee;
        color: #777777;
        font-size: 14px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
      }
      .meta-tag {
        background: #f0f0f0;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #555;
      }

      /* UNIFORM CONTROLLED IMAGE SIZING */
      .featured-figure {
        margin: 0 0 35px;
        width: 100%;
      }
      .featured-img {
        width: 100%;
        max-height: 420px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        display: block;
      }
      .img-caption {
        font-size: 12px;
        color: #888;
        text-align: center;
        margin-top: 8px;
      }

      .article-content {
        font-size: 18px;
        color: #242424;
      }
      .article-content :global(h2) {
        margin-top: 45px;
        margin-bottom: 16px;
        color: #111111;
        font-size: 26px;
        line-height: 1.25;
        letter-spacing: -0.5px;
        border-left: 4px solid #d65d7a;
        padding-left: 12px;
      }
      .article-content :global(h3) {
        margin-top: 32px;
        margin-bottom: 12px;
        color: #111111;
        font-size: 21px;
        line-height: 1.35;
      }
      .article-content :global(p) { margin: 0 0 22px; }
      .article-content :global(ul), .article-content :global(ol) {
        margin: 0 0 25px;
        padding-left: 28px;
      }
      .article-content :global(li) { margin-bottom: 10px; }
      .article-content :global(blockquote) {
        margin: 30px 0;
        padding: 18px 24px;
        border-left: 4px solid #d65d7a;
        background: #faf5f6;
        color: #444;
        border-radius: 0 12px 12px 0;
      }

      /* IN-ARTICLE EMBEDDED MEDIA STYLING */
      .article-content :global(.in-article-video) {
        margin: 35px 0;
        background: #111;
        padding: 16px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      }
      .article-content :global(.video-label) {
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
        padding: 0 4px;
      }
      .article-content :global(.video-responsive-frame) {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
        background: #000;
      }
      .article-content :global(.video-responsive-frame iframe) {
        width: 100%;
        height: 100%;
        border: 0;
      }

      .article-content :global(.in-article-figure) {
        margin: 35px 0;
        text-align: center;
      }
      .article-content :global(.in-article-img) {
        width: 100%;
        max-height: 400px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
      }
      .article-content :global(.in-article-caption) {
        font-size: 12px;
        color: #888;
        margin-top: 8px;
      }

      .faq-section {
        margin-top: 55px;
        padding-top: 35px;
        border-top: 1px solid #eeeeee;
      }
      .faq-section h2 {
        margin: 0 0 24px;
        font-size: 26px;
        color: #111;
      }
      .faq-item {
        background: #faf8f7;
        padding: 20px 24px;
        border-radius: 14px;
        margin-bottom: 16px;
        border: 1px solid #eee5e2;
      }
      .faq-question {
        margin: 0 0 8px;
        font-size: 17px;
        font-weight: 700;
        color: #111;
      }
      .faq-answer {
        margin: 0;
        color: #555;
        font-size: 15px;
        line-height: 1.6;
      }

      .related-section {
        margin-top: 55px;
        padding-top: 35px;
        border-top: 1px solid #eeeeee;
      }
      .related-section h2 {
        margin: 0 0 20px;
        font-size: 24px;
        color: #111;
      }
      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }
      .related-card {
        padding: 20px;
        background: #faf8f7;
        border-radius: 14px;
        text-decoration: none;
        border: 1px solid #ece7e4;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .related-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      }
      .related-card h3 {
        margin: 0 0 8px;
        font-size: 17px;
        color: #111;
        line-height: 1.35;
      }
      .related-card p {
        margin: 0;
        font-size: 13px;
        color: #666;
        line-height: 1.5;
      }

      .site-footer {
        padding: 40px 20px;
        border-top: 1px solid #eeeeee;
        text-align: center;
        color: #777;
        font-size: 14px;
        background: #ffffff;
      }
      .footer-links {
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #555;
        text-decoration: none;
        margin: 0 10px;
        font-size: 13px;
      }
      .footer-links a:hover { color: #d65d7a; }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">BeautyTrend<span>Daily</span></a>
        <a class="back-link" href="/">← Latest Articles</a>
      </div>
    </header>

    <main>
      <article class="article-wrapper">
        <a class="category-pill" href={`/category/${categorySlug}/`}>
          {category}
        </a>

        <h1>{title}</h1>

        <p class="excerpt">
          {excerpt || description}
        </p>

        <div class="meta">
          <span>Published {formattedDate}</span>
          {formattedUpdatedDate && <span>· Updated {formattedUpdatedDate}</span>}
          <span class="meta-tag">📖 {readingTimeMin} min read</span>
          <span class="meta-tag">✨ 2026 Verified Trend</span>
        </div>

        <figure class="featured-figure">
          <img src={featuredImage} alt={title} class="featured-img" loading="eager" />
          {imageCredit && <figcaption class="img-caption">{imageCredit}</figcaption>}
        </figure>

        <div class="article-content">
          <Content />
        </div>

        {
          faq && faq.length > 0 && (
            <section class="faq-section">
              <h2>Frequently Asked Questions</h2>
              {faq.map((item) => (
                <div class="faq-item">
                  <h3 class="faq-question">{item.question}</h3>
                  <p class="faq-answer">{item.answer}</p>
                </div>
              ))}
            </section>
          )
        }

        {
          relatedArticles.length > 0 && (
            <section class="related-section">
              <h2>More From {category}</h2>
              <div class="related-grid">
                {relatedArticles.map((rel) => (
                  <a class="related-card" href={`/articles/${rel.id.replace(/\.md$/, '')}/`}>
                    <h3>{rel.data.title}</h3>
                    <p>{rel.data.excerpt || rel.data.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </article>
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
      </div>
      <div>© {new Date().getFullYear()} BeautyTrend Daily. All rights reserved.</div>
    </footer>
  </body>
</html>
