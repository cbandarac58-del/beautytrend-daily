---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => {
    return (
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime()
    );
  });

const categories = [
  'Haircuts',
  'Hairstyles',
  'Hair Color',
  'Nail Styles',
  'Nail Art',
  'Beauty Trends'
];

const siteUrl = 'https://beautytrend-daily.pages.dev';

const latestArticles = articles.slice(0, 12);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#faf8f7" />

    <title>
      BeautyTrend Daily | Hair, Hairstyles, Nails & Beauty Trends
    </title>

    <meta
      name="description"
      content="Discover haircut ideas, hairstyle inspiration, nail art, manicure trends and practical beauty guides from BeautyTrend Daily."
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link
      rel="canonical"
      href={`${siteUrl}/`}
    />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content="BeautyTrend Daily | Hair, Hairstyles, Nails & Beauty Trends"
    />

    <meta
      property="og:description"
      content="Discover fresh hair, nail and beauty inspiration, trends and practical beauty guides."
    />

    <meta
      property="og:url"
      content={`${siteUrl}/`}
    />

    <meta
      property="og:site_name"
      content="BeautyTrend Daily"
    />

    <!-- Twitter -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content="BeautyTrend Daily | Hair, Hairstyles, Nails & Beauty Trends"
    />

    <meta
      name="twitter:description"
      content="Discover fresh hair, nail and beauty inspiration, trends and practical beauty guides."
    />

    <!-- Website Schema -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'BeautyTrend Daily',
        url: siteUrl,
        description:
          'Hair, hairstyles, nail and beauty trends and practical beauty guides.',
      })}
    />

    <!-- Organization Schema -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'BeautyTrend Daily',
        url: siteUrl,
      })}
    />
  </head>

  <body>

    <!-- HEADER -->

    <header class="header">
      <div class="container nav">

        <a
          href="/"
          class="logo"
          aria-label="BeautyTrend Daily home"
        >
          BeautyTrend<span>Daily</span>
        </a>

        <nav aria-label="Main navigation">
          {categories.map((category) => (
            <a
              href={`/category/${category
                .toLowerCase()
                .replaceAll(' ', '-')}/`}
            >
              {category}
            </a>
          ))}
        </nav>

      </div>
    </header>


    <!-- MAIN -->

    <main>

      <!-- HERO -->

      <section class="hero">
        <div class="container hero-inner">

          <p class="eyebrow">
            HAIR · NAILS · BEAUTY
          </p>

          <h1>
            Discover Your Next
            <span>Beauty Inspiration</span>
          </h1>

          <p class="intro">
            Explore haircut trends, modern hairstyles, beautiful
            nail designs and practical beauty guides to help you
            find your next look.
          </p>

          <a
            href="#latest"
            class="button"
          >
            Explore Latest Articles
          </a>

        </div>
      </section>


      <!-- CATEGORIES -->

      <section class="category-section">

        <div class="container">

          <p class="eyebrow">
            EXPLORE BY INTEREST
          </p>

          <div class="category-list">

            {categories.map((category) => (
              <a
                class="category-pill"
                href={`/category/${category
                  .toLowerCase()
                  .replaceAll(' ', '-')}/`}
              >
                {category}
              </a>
            ))}

          </div>

        </div>

      </section>


      <!-- LATEST ARTICLES -->

      <section
        id="latest"
        class="latest"
      >

        <div class="container">

          <div class="section-heading">

            <div>

              <p class="eyebrow">
                THE LATEST
              </p>

              <h2>
                Fresh Beauty Inspiration
              </h2>

            </div>

            <p>
              Ideas, trends and practical guides for your
              next look.
            </p>

          </div>


          {
            latestArticles.length > 0 ? (

              <div class="article-grid">

                {latestArticles.map((article) => (

                  <article
                    class="article-card"
                  >

                    <a
                      class="article-link"
                      href={`/articles/${article.id.replace(
                        /\.md$/,
                        ''
                      )}/`}
                    >

                      <div
                        class="article-art"
                        aria-hidden="true"
                      >

                        <span>
                          BEAUTY
                        </span>

                        <span class="art-star">
                          ✳
                        </span>

                      </div>


                      <div class="article-info">

                        <p class="article-category">
                          {article.data.category ||
                            'Beauty & Style'}
                        </p>

                        <h3>
                          {article.data.title}
                        </h3>

                        <p class="article-excerpt">
                          {article.data.excerpt ||
                            article.data.description}
                        </p>

                        <span class="read-more">
                          Read article →
                        </span>

                      </div>

                    </a>

                  </article>

                ))}

              </div>

            ) : (

              <div class="empty-card">

                <h3>
                  Your beauty inspiration starts here
                </h3>

                <p>
                  New articles will appear here when they
                  are generated and published to the website.
                </p>

              </div>

            )
          }

        </div>

      </section>

    </main>


    <!-- FOOTER -->

    <footer>

      <div class="container footer-inner">

        <a
          href="/"
          class="logo"
        >
          BeautyTrend<span>Daily</span>
        </a>

        <p>
          Hair, nails, beauty trends and inspiration.
        </p>

        <p>
          © {new Date().getFullYear()}
          BeautyTrend Daily.
        </p>

      </div>

    </footer>

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #faf8f7;
    color: #292221;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }


  /* CONTAINER */

  .container {
    width: min(
      1120px,
      calc(100% - 40px)
    );

    margin-inline: auto;
  }


  /* HEADER */

  .header {
    position: sticky;
    top: 0;
    z-index: 10;

    background: rgba(
      255,
      255,
      255,
      0.96
    );

    border-bottom: 1px solid #eee6e3;

    backdrop-filter: blur(12px);
  }

  .nav {
    min-height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 28px;
  }

  .logo {
    color: #292221;

    text-decoration: none;

    font-size: 23px;
    font-weight: 800;

    letter-spacing: -1px;

    white-space: nowrap;
  }

  .logo span {
    font-weight: 400;
  }


  /* NAVIGATION */

  nav {
    display: flex;
    align-items: center;

    gap: 20px;

    overflow-x: auto;

    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  nav a {
    color: #6d6260;

    font-size: 13px;

    text-decoration: none;

    white-space: nowrap;
  }

  nav a:hover {
    color: #a04d60;
  }


  /* HERO */

  .hero {
    padding: 105px 0 110px;

    background:
      radial-gradient(
        ellipse at 85% 20%,
        #e9d4d5 0,
        transparent 35%
      ),
      radial-gradient(
        ellipse at 10% 90%,
        #f0e1d9 0,
        transparent 35%
      ),
      #faf5f1;
  }

  .hero-inner {
    max-width: 1120px;
  }

  .eyebrow {
    color: #986c70;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 2.5px;

    margin: 0 0 18px;
  }

  h1 {
    max-width: 850px;

    font-size:
      clamp(
        46px,
        8vw,
        82px
      );

    line-height: 1.02;

    letter-spacing: -4px;

    margin: 0;
  }

  h1 span {
    display: block;

    font-weight: 400;

    color: #a15e68;
  }

  .intro {
    max-width: 620px;

    color: #716563;

    line-height: 1.8;

    font-size: 17px;

    margin: 25px 0 30px;
  }

  .button {
    display: inline-block;

    background: #342526;

    color: white;

    padding: 15px 23px;

    border-radius: 5px;

    text-decoration: none;

    font-size: 14px;

    font-weight: 700;
  }

  .button:hover {
    background: #a15e68;
  }


  /* CATEGORY SECTION */

  .category-section {
    padding: 35px 0;

    background: white;

    border-bottom: 1px solid #eee6e3;
  }

  .category-list {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;
  }

  .category-pill {
    display: inline-block;

    padding: 10px 15px;

    border: 1px solid #eadedb;

    border-radius: 30px;

    color: #655451;

    font-size: 13px;

    text-decoration: none;

    transition:
      border-color .2s,
      color .2s;
  }

  .category-pill:hover {
    border-color: #a15e68;

    color: #a15e68;
  }


  /* LATEST */

  .latest {
    padding: 80px 0 100px;
  }

  .section-heading {
    display: flex;

    align-items: end;

    justify-content: space-between;

    gap: 25px;

    margin-bottom: 35px;
  }

  .section-heading .eyebrow {
    margin-bottom: 12px;
  }

  h2 {
    margin: 0;

    font-size:
      clamp(
        30px,
        5vw,
        44px
      );

    letter-spacing: -2px;
  }

  .section-heading > p {
    color: #766a68;

    line-height: 1.7;

    max-width: 340px;
  }


  /* ARTICLE GRID */

  .article-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 25px;
  }

  .article-card {
    background: white;

    border: 1px solid #eee5e2;

    border-radius: 10px;

    overflow: hidden;

    transition:
      transform .2s,
      box-shadow .2s;
  }

  .article-card:hover {
    transform: translateY(-3px);

    box-shadow:
      0 12px 30px
      rgba(56, 37, 34, 0.08);
  }

  .article-link {
    display: block;

    height: 100%;

    color: inherit;

    text-decoration: none;
  }


  /* ARTICLE VISUAL */

  .article-art {
    min-height: 170px;

    padding: 20px;

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    background:
      linear-gradient(
        135deg,
        #f2e5df,
        #e9d2d6
      );

    color: #85565c;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2px;
  }

  .art-star {
    font-size: 36px;

    font-weight: 400;
  }


  /* ARTICLE INFO */

  .article-info {
    padding: 23px;
  }

  .article-category {
    margin: 0 0 10px;

    color: #a15e68;

    font-size: 11px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 1px;
  }

  h3 {
    font-size: 21px;

    line-height: 1.4;

    margin: 0 0 12px;

    letter-spacing: -.4px;
  }

  .article-excerpt {
    color: #756a68;

    font-size: 14px;

    line-height: 1.75;
  }

  .read-more {
    display: inline-block;

    margin-top: 10px;

    color: #985964;

    font-size: 13px;

    font-weight: 700;
  }


  /* EMPTY */

  .empty-card {
    padding: 60px 25px;

    border: 1px solid #eee5e2;

    background: white;

    border-radius: 10px;

    text-align: center;
  }

  .empty-card p {
    color: #756a68;

    line-height: 1.8;
  }


  /* FOOTER */

  footer {
    background: white;

    border-top: 1px solid #eee5e2;

    padding: 38px 0;
  }

  .footer-inner {
    display: flex;

    align-items: center;

    justify-content: space-between;

    flex-wrap: wrap;

    gap: 15px;
  }

  .footer-inner p {
    color: #756a68;

    font-size: 13px;
  }


  /* TABLET */

  @media (max-width: 850px) {

    .nav {
      align-items: flex-start;

      flex-direction: column;

      padding: 18px 0;

      gap: 14px;
    }

    nav {
      width: 100%;

      padding-bottom: 5px;
    }

    .article-grid {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .hero {
      padding: 75px 0;
    }

    h1 {
      letter-spacing: -2px;
    }

  }


  /* MOBILE */

  @media (max-width: 560px) {

    .container {
      width:
        calc(100% - 30px);
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p {
      margin-top: 12px;
    }

    .footer-inner {
      align-items: flex-start;

      flex-direction: column;
    }

  }

</style>
