---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: {
      slug: article.id.replace(/\.md$/, ''),
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const siteUrl = 'https://beautytrend-daily.pages.dev';

const {
  title,
  description,
  excerpt,
  category,
  keywords,
  publishedAt,
  updatedAt,
  youtube,
  faq,
} = article.data;

const slug = article.id.replace(/\.md$/, '');

const canonicalUrl = `${siteUrl}/articles/${slug}/`;

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt
    ? new Date(updatedAt).toISOString()
    : new Date(publishedAt).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily',
  },
  publisher: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily',
    url: siteUrl,
  },
  articleSection: category,
  keywords: keywords.join(', '),
};

const faqSchema =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title} | BeautyTrend Daily</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="keywords"
      content={keywords.join(', ')}
    />

    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->

    <meta property="og:type" content="article" />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:site_name"
      content="BeautyTrend Daily"
    />

    <meta
      property="article:published_time"
      content={new Date(publishedAt).toISOString()}
    />

    {updatedAt && (
      <meta
        property="article:modified_time"
        content={new Date(updatedAt).toISOString()}
      />
    )}

    <meta
      property="article:section"
      content={category}
    />

    <!-- Twitter -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <!-- Article Structured Data -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    <!-- FAQ Structured Data -->

    {faqSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )}

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #ffffff;
        color: #202020;
        font-family:
          Arial,
          Helvetica,
          sans-serif;
      }

      .site-header {
        border-bottom: 1px solid #eeeeee;
        background: #ffffff;
      }

      .header-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .logo {
        color: #111111;
        text-decoration: none;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      .back-link {
        color: #555555;
        text-decoration: none;
        font-size: 14px;
      }

      .back-link:hover {
        color: #000000;
      }

      .article-wrapper {
        max-width: 820px;
        margin: 0 auto;
        padding: 50px 20px 80px;
      }

      .category {
        display: inline-block;
        margin-bottom: 16px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #f4f4f4;
        color: #555555;
        font-size: 13px;
        font-weight: 700;
      }

      h1 {
        margin: 0 0 18px;
        color: #111111;
        font-size: clamp(34px, 6vw, 54px);
        line-height: 1.08;
        letter-spacing: -1.5px;
      }

      .excerpt {
        margin: 0 0 22px;
        color: #666666;
        font-size: 19px;
        line-height: 1.6;
      }

      .meta {
        padding-bottom: 28px;
        margin-bottom: 35px;
        border-bottom: 1px solid #eeeeee;
        color: #777777;
        font-size: 14px;
      }

      .article-content {
        font-size: 18px;
        line-height: 1.8;
      }

      .article-content :global(h2) {
        margin-top: 45px;
        margin-bottom: 15px;
        color: #111111;
        font-size: 30px;
        line-height: 1.2;
      }

      .article-content :global(h3) {
        margin-top: 32px;
        margin-bottom: 12px;
        color: #111111;
        font-size: 23px;
        line-height: 1.3;
      }

      .article-content :global(p) {
        margin: 0 0 22px;
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        margin: 0 0 25px;
        padding-left: 28px;
      }

      .article-content :global(li) {
        margin-bottom: 8px;
      }

      .article-content :global(a) {
        color: #7a3cff;
        text-decoration: underline;
      }

      .article-content :global(blockquote) {
        margin: 30px 0;
        padding: 18px 22px;
        border-left: 4px solid #dddddd;
        background: #f8f8f8;
        color: #555555;
      }

      .videos {
        margin-top: 55px;
        padding-top: 35px;
        border-top: 1px solid #eeeeee;
      }

      .videos h2 {
        margin: 0 0 25px;
        font-size: 28px;
        color: #111111;
      }

      .video-card {
        margin-bottom: 35px;
      }

      .video-title {
        margin: 0 0 12px;
        font-size: 18px;
        font-weight: 700;
        color: #222222;
      }

      .video-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
        background: #eeeeee;
      }

      .video-frame iframe {
        width: 100%;
        height: 100%;
        border: 0;
      }

      .faq {
        margin-top: 55px;
        padding-top: 35px;
        border-top: 1px solid #eeeeee;
      }

      .faq h2 {
        margin: 0 0 25px;
        font-size: 28px;
        color: #111111;
      }

      .faq-item {
        margin-bottom: 25px;
      }

      .faq-question {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 700;
        color: #222222;
      }

      .faq-answer {
        margin: 0;
        color: #555555;
        line-height: 1.7;
      }

      .site-footer {
        padding: 35px 20px;
        border-top: 1px solid #eeeeee;
        text-align: center;
        color: #777777;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        .header-inner {
          padding: 15px;
        }

        .article-wrapper {
          padding: 35px 17px 60px;
        }

        .article-content {
          font-size: 17px;
        }

        .article-content :global(h2) {
          font-size: 26px;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">
          BeautyTrend Daily
        </a>

        <a class="back-link" href="/">
          ← Latest Articles
        </a>
      </div>
    </header>

    <main>
      <article class="article-wrapper">

        <div class="category">
          {category}
        </div>

        <h1>{title}</h1>

        <p class="excerpt">
          {excerpt || description}
        </p>

        <div class="meta">
          Published {formattedDate}

          {formattedUpdatedDate && (
            <>
              · Updated {formattedUpdatedDate}
            </>
          )}
        </div>

        <div class="article-content">
          <Content />
        </div>

        {
          youtube && youtube.length > 0 && (
            <section class="videos">
              <h2>Related Videos</h2>

              {youtube.map((video) => (
                <div class="video-card">

                  <h3 class="video-title">
                    {video.title}
                  </h3>

                  <div class="video-frame">
                    <iframe
                      src={`https://www.youtube.com/embed/${video.videoId}`}
                      title={video.title}
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>

                </div>
              ))}
            </section>
          )
        }

        {
          faq && faq.length > 0 && (
            <section class="faq">

              <h2>
                Frequently Asked Questions
              </h2>

              {faq.map((item) => (
                <div class="faq-item">

                  <h3 class="faq-question">
                    {item.question}
                  </h3>

                  <p class="faq-answer">
                    {item.answer}
                  </p>

                </div>
              ))}

            </section>
          )
        }

      </article>
    </main>

    <footer class="site-footer">
      © {new Date().getFullYear()} BeautyTrend Daily. All rights reserved.
    </footer>
  </body>
</html>
