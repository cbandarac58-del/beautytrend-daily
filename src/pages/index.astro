---
const categories = [
  'Haircuts',
  'Hairstyles',
  'Hair Color',
  'Nail Styles',
  'Nail Art',
  'Beauty Trends'
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The latest haircut, hairstyle, nail and beauty trends, ideas and inspiration."
    />
    <title>BeautyTrend Daily — Hair, Nails & Beauty Inspiration</title>
  </head>

  <body>
    <header class="header">
      <div class="container nav">
        <a href="/" class="logo">BeautyTrend<span>Daily</span></a>

        <nav>
          {categories.map((category) => (
            <a href="#">{category}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <p class="eyebrow">BEAUTY • HAIR • NAILS</p>

          <h1>
            Discover Your Next
            <span>Beauty Inspiration</span>
          </h1>

          <p class="intro">
            Fresh ideas, trending hairstyles, beautiful nail designs,
            haircut inspiration and beauty guides — all in one place.
          </p>

          <a href="#latest" class="button">Explore Latest Trends</a>
        </div>
      </section>

      <section id="latest" class="latest">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">LATEST</p>
            <h2>Fresh Beauty Inspiration</h2>
            <p>
              New beauty articles, ideas and trends will appear here
              automatically.
            </p>
          </div>

          <div class="empty-card">
            <div class="icon">✦</div>
            <h3>Coming Soon</h3>
            <p>
              Our automatic beauty magazine system is being built.
              New articles will soon be published every day.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <strong>BeautyTrend Daily</strong>
        <p>Hair, nails, beauty trends and inspiration.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #faf8f7;
    color: #211d1d;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .header {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #eee7e5;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    color: #211d1d;
    text-decoration: none;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.7px;
    white-space: nowrap;
  }

  .logo span {
    font-weight: 400;
  }

  nav {
    display: flex;
    gap: 20px;
    overflow-x: auto;
  }

  nav a {
    color: #6c6260;
    text-decoration: none;
    font-size: 14px;
    white-space: nowrap;
  }

  nav a:hover {
    color: #211d1d;
  }

  .hero {
    padding: 110px 0 120px;
    background:
      radial-gradient(circle at 85% 20%, #ead9d7 0, transparent 28%),
      radial-gradient(circle at 15% 80%, #eee2dd 0, transparent 30%);
  }

  .hero .container {
    max-width: 900px;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    color: #88716c;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.98;
    letter-spacing: -4px;
  }

  h1 span {
    display: block;
    font-weight: 400;
  }

  .intro {
    max-width: 650px;
    margin: 30px 0;
    color: #6c6260;
    font-size: 18px;
    line-height: 1.7;
  }

  .button {
    display: inline-block;
    padding: 14px 22px;
    background: #211d1d;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 700;
  }

  .latest {
    padding: 90px 0;
  }

  .section-heading {
    margin-bottom: 35px;
  }

  h2 {
    margin: 0 0 12px;
    font-size: clamp(32px, 5vw, 50px);
    letter-spacing: -2px;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: #746b69;
  }

  .empty-card {
    border: 1px solid #e8dfdc;
    background: white;
    padding: 60px 30px;
    text-align: center;
    border-radius: 12px;
  }

  .icon {
    font-size: 38px;
    margin-bottom: 15px;
  }

  h3 {
    margin: 0 0 10px;
    font-size: 25px;
  }

  .empty-card p {
    max-width: 560px;
    margin: 0 auto;
    color: #746b69;
    line-height: 1.7;
  }

  footer {
    padding: 45px 0;
    border-top: 1px solid #e8dfdc;
    background: white;
  }

  footer p {
    color: #746b69;
    margin-bottom: 0;
  }

  @media (max-width: 800px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      padding: 18px 0;
      gap: 14px;
    }

    nav {
      width: 100%;
      padding-bottom: 4px;
    }

    .hero {
      padding: 75px 0 85px;
    }

    h1 {
      letter-spacing: -2.5px;
    }
  }
</style>
