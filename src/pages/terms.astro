<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms of Service | BeautyTrend Daily</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <style>
      :global(*) { box-sizing: border-box; }
      body {
        margin: 0;
        background: #faf8f7;
        color: #202020;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.7;
      }
      .container { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
      .header { background: #fff; border-bottom: 1px solid #eee; padding: 16px 20px; }
      .logo { font-size: 22px; font-weight: 800; color: #111; text-decoration: none; }
      .logo span { color: #d65d7a; }
      .content-box { background: #fff; padding: 40px; border-radius: 16px; border: 1px solid #eee5e2; }
      h1 { font-size: 32px; margin: 0 0 16px; color: #111; }
      p { margin: 0 0 16px; color: #555; }
      .back { display: inline-block; margin-bottom: 20px; color: #d65d7a; text-decoration: none; font-weight: 700; }
    </style>
  </head>
  <body>
    <header class="header">
      <div style="max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
        <a href="/" class="logo">BeautyTrend<span>Daily</span></a>
        <a href="/" style="color: #666; text-decoration: none; font-size: 14px;">← Home</a>
      </div>
    </header>

    <main class="container">
      <a href="/" class="back">← Back to Home</a>
      <div class="content-box">
        <h1>Terms of Service</h1>
        <p>
          By accessing and using BeautyTrend Daily, you agree to comply with and be bound by the following terms and conditions.
        </p>
        <p>
          All content provided on this website is for informational and style inspiration purposes only. Always consult with a licensed salon professional before undertaking drastic hair treatments or chemical procedures.
        </p>
      </div>
    </main>
  </body>
</html>
