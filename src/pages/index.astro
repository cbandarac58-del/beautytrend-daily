---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort((a, b) => {
  return (
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
  );
});

const categories = [
  { slug: 'haircuts', name: 'Haircuts' },
  { slug: 'hairstyles', name: 'Hairstyles' },
  { slug: 'hair-color', name: 'Hair Color' },
  { slug: 'nail-styles', name: 'Nail Styles' },
  { slug: 'nail-art', name: 'Nail Art' },
  { slug: 'beauty-trends', name: 'Beauty Trends' },
];

const siteUrl = 'https://beautytrend-daily.pages.dev';

const DEFAULT_CATEGORY_IMAGES: Record<string, string> = {
  Haircuts: 'https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=800&q=80',
  Hairstyles: 'https://images.unsplash.com/photo-1519699047748-de8e457a634e?auto=format&fit=crop&w=800&q=80',
  'Hair Color': 'https://images.unsplash.com/photo-1580618672591-eb180b1a973f?auto=format&fit=crop&w=800&q=80',
  'Nail Styles': 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80',
  'Nail Art': 'https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=800&q=80',
  'Beauty Trends': 'https://images.unsplash.com/photo-1512290900672-1f0230722391?auto=format&fit=crop&w=800&q=80',
};

// ItemList Schema for SEO
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Latest BeautyTrend Daily Articles',
  itemListElement: articles.map((article, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `${siteUrl}/articles/${article.id.replace(/\.md$/, '')}/`,
    name: article.data.title,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf8f7" />

    <title>BeautyTrend Daily | Hair, Hairstyles, Nails & Beauty Trends 2026</title>
    <meta
      name="description"
      content="Discover the latest haircut trends, hairstyles, hair colors, nail art, manicure ideas and beauty inspiration from BeautyTrend Daily."
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BeautyTrend Daily | Hair, Hairstyles, Nails & Beauty Trends" />
    <meta property="og:description" content="Explore fresh haircut ideas, hairstyles, hair colors, nail art and beauty trends." />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:site_name" content="BeautyTrend Daily" />

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

    <style>
      :global(*) { box-sizing: border-box; }
      body {
        margin: 0;
        background: #faf8f7;
        color: #202020;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .container { max-width: 1160px; margin: 0 auto; padding: 0 20px; }

      .header {
        background: #ffffff;
        border-bottom: 1px solid #eeeeee;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
      }
      .logo {
        font-size: 22px;
        font-weight: 800;
        color: #111;
        text-decoration: none;
        letter-spacing: -0.5px;
      }
      .logo span { color: #d65d7a; }

      .nav-links {
        display: flex;
        gap: 16px;
        overflow-x: auto;
      }
      .nav-links a {
        color: #555;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transition: color 0.2s;
      }
      .nav-links a:hover { color: #d65d7a; }

      .hero {
        padding: 60px 0 45px;
        text-align: center;
      }
      .eyebrow {
        text-transform: uppercase;
        font-size: 12px;
        font-weight: 800;
        color: #d65d7a;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
      }
      h1 {
        font-size: clamp(34px, 5.5vw, 52px);
        line-height: 1.1;
        margin: 0 0 16px;
        color: #111;
        letter-spacing: -1.5px;
      }
      h1 span { color: #d65d7a; display: block; }
      .intro {
        color: #555;
        font-size: 18px;
        max-width: 620px;
        margin: 0 auto 28px;
        line-height: 1.6;
      }
      .button {
        display: inline-block;
        background: #111;
        color: #fff;
        padding: 12px 28px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        transition: background 0.2s;
      }
      .button:hover { background: #d65d7a; }

      .category-section {
        padding: 20px 0 40px;
      }
      .category-list {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        background: #ffffff;
        border: 1px solid #e8e2de;
        border-radius: 999px;
        color: #333;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s;
      }
      .category-pill:hover {
        border-color: #d65d7a;
        color: #d65d7a;
        transform: translateY(-2px);
      }

      .latest-heading {
        margin: 40px 0 25px;
        border-bottom: 2px solid #111;
        padding-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }
      .latest-heading h2 {
        margin: 0;
        font-size: 26px;
        color: #111;
        letter-spacing: -0.5px;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
        padding-bottom: 80px;
      }
      .article-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #ece6e2;
        transition: transform 0.25s, box-shadow 0.25s;
        display: flex;
        flex-direction: column;
      }
      .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 32px rgba(0,0,0,0.06);
      }
      .card-img-wrap {
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #f4eee9;
      }
      .card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s;
      }
      .article-card:hover .card-img {
        transform: scale(1.05);
      }
      .card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .card-category {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: #d65d7a;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
      }
      .card-title {
        font-size: 20px;
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 10px;
        color: #111;
      }
      .card-excerpt {
        font-size: 14px;
        line-height: 1.6;
        color: #666;
        margin: 0 0 18px;
        flex-grow: 1;
      }
      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 700;
        color: #111;
      }

      .footer {
        background: #ffffff;
        border-top: 1px solid #eeeeee;
        padding: 45px 0 30px;
        text-align: center;
        color: #666;
      }
      .footer-links {
        margin-bottom: 16px;
      }
      .footer-links a {
        color: #444;
        text-decoration: none;
        margin: 0 12px;
        font-size: 14px;
        font-weight: 600;
      }
      .footer-links a:hover { color: #d65d7a; }
    </style>
  </head>

  <body>
    <header class="header">
      <div class="container nav">
        <a href="/" class="logo">BeautyTrend<span>Daily</span></a>
        <nav class="nav-links">
          {categories.map((cat) => (
            <a href={`/category/${cat.slug}/`}>{cat.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <p class="eyebrow">HAIR · NAILS · BEAUTY</p>
        <h1>Discover Your Next<span>Beauty Inspiration</span></h1>
        <p class="intro">
          Explore the freshest haircut trends, modern hairstyles, beautiful nail designs, hair colors and practical beauty guides for 2026.
        </p>
        <a href="#latest" class="button">Explore Latest Trends</a>
      </section>

      <section class="category-section">
        <div class="category-list">
          {categories.map((cat) => (
            <a class="category-pill" href={`/category/${cat.slug}/`}>
              <span>{cat.name}</span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section id="latest">
        <div class="latest-heading">
          <h2>Fresh Beauty Inspiration</h2>
          <span style="font-size: 14px; color: #888;">{articles.length} Trending Guides</span>
        </div>

        <div class="article-grid">
          {articles.map((art) => {
            const slug = art.id.replace(/\.md$/, '');
            const imgUrl = art.data.heroImage || DEFAULT_CATEGORY_IMAGES[art.data.category] || DEFAULT_CATEGORY_IMAGES.Haircuts;
            return (
              <article class="article-card">
                <a href={`/articles/${slug}/`} style="text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%;">
                  <div class="card-img-wrap">
                    <img src={imgUrl} alt={art.data.title} class="card-img" loading="lazy" />
                  </div>
                  <div class="card-body">
                    <div class="card-category">{art.data.category}</div>
                    <h3 class="card-title">{art.data.title}</h3>
                    <p class="card-excerpt">{art.data.excerpt || art.data.description}</p>
                    <div class="card-footer">
                      <span>Read Article →</span>
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/about/">About Us</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href="/contact/">Contact Us</a>
        </div>
        <p style="font-size: 13px; color: #999; margin-top: 10px;">
          © {new Date().getFullYear()} BeautyTrend Daily. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
