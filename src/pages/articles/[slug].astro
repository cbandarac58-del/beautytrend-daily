---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: {
      slug: article.id.replace(/\.md$/, ''),
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const siteUrl = 'https://beautytrend-daily.pages.dev';

const {
  title,
  description,
  excerpt,
  category,
  keywords = [],
  publishedAt,
  updatedAt,
  youtube = [],
  faq = [],
} = article.data;

const slug = article.id.replace(/\.md$/, '');

const canonicalUrl = `${siteUrl}/articles/${slug}/`;

const categorySlug = category
  .toLowerCase()
  .trim()
  .replace(/\s+/g, '-');

const formattedDate = new Date(publishedAt).toLocaleDateString(
  'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);

const formattedUpdatedDate = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

/* -----------------------------
   ARTICLE SCHEMA
----------------------------- */

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: updatedAt
    ? new Date(updatedAt).toISOString()
    : new Date(publishedAt).toISOString(),

  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },

  author: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily',
    url: siteUrl,
  },

  publisher: {
    '@type': 'Organization',
    name: 'BeautyTrend Daily',
    url: siteUrl,
  },

  articleSection: category,

  keywords: keywords.join(', '),

  isPartOf: {
    '@type': 'WebSite',
    name: 'BeautyTrend Daily',
    url: siteUrl,
  },
};

/* -----------------------------
   BREADCRUMB SCHEMA
----------------------------- */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: `${siteUrl}/category/${categorySlug}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    },
  ],
};

/* -----------------------------
   FAQ SCHEMA
----------------------------- */

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;

/* -----------------------------
   RELATED ARTICLES
----------------------------- */

const allArticles = await getCollection('articles');

const relatedArticles = allArticles
  .filter((item) => item.id !== article.id)
  .filter((item) => item.data.category === category)
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime()
  )
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#faf8f7" />

    <title>{title} | BeautyTrend Daily</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="keywords"
      content={keywords.join(', ')}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large"
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:site_name"
      content="BeautyTrend Daily"
    />

    <meta
      property="article:published_time"
      content={new Date(publishedAt).toISOString()}
    />

    <meta
      property="article:section"
      content={category}
    />

    {updatedAt && (
      <meta
        property="article:modified_time"
        content={new Date(updatedAt).toISOString()}
      />
    )}

    <!-- Twitter -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <!-- Article Schema -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    <!-- Breadcrumb Schema -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />

    <!-- FAQ Schema -->

    {faqSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )}

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #faf8f7;
        color: #292221;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      :global(a) {
        -webkit-tap-highlight-color: transparent;
      }

      /* HEADER */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.96);
        border-bottom: 1px solid #eee6e3;
        backdrop-filter: blur(12px);
      }

      .header-inner {
        width: min(1120px, calc(100% - 40px));
        min-height: 72px;
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 25px;
      }

      .logo {
        color: #292221;
        text-decoration: none;

        font-size: 23px;
        font-weight: 800;
        letter-spacing: -1px;

        white-space: nowrap;
      }

      .logo span {
        font-weight: 400;
      }

      .back-link {
        color: #6d6260;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }

      .back-link:hover {
        color: #a15e68;
      }

      /* ARTICLE */

      .article-wrapper {
        width: min(820px, calc(100% - 40px));
        margin: 0 auto;

        padding: 55px 0 80px;
      }

      .category {
        display: inline-block;

        margin-bottom: 18px;
        padding: 7px 12px;

        border-radius: 999px;

        background: #f1e3e1;
        color: #955b64;

        font-size: 12px;
        font-weight: 800;

        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 20px;

        color: #292221;

        font-size:
          clamp(
            38px,
            7vw,
            62px
          );

        line-height: 1.06;

        letter-spacing: -2.5px;
      }

      .excerpt {
        margin: 0 0 24px;

        color: #716563;

        font-size: 19px;
        line-height: 1.75;
      }

      .meta {
        padding-bottom: 28px;
        margin-bottom: 38px;

        border-bottom: 1px solid #e9e0dd;

        color: #817573;

        font-size: 14px;
      }

      /* CONTENT */

      .article-content {
        font-size: 18px;
        line-height: 1.85;
      }

      .article-content :global(h2) {
        margin-top: 48px;
        margin-bottom: 17px;

        color: #292221;

        font-size: 30px;
        line-height: 1.25;

        letter-spacing: -0.8px;
      }

      .article-content :global(h3) {
        margin-top: 34px;
        margin-bottom: 13px;

        color: #292221;

        font-size: 23px;
        line-height: 1.35;
      }

      .article-content :global(p) {
        margin: 0 0 23px;
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        margin: 0 0 27px;
        padding-left: 28px;
      }

      .article-content :global(li) {
        margin-bottom: 9px;
      }

      .article-content :global(a) {
        color: #9b5864;
        font-weight: 600;
      }

      .article-content :global(blockquote) {
        margin: 32px 0;

        padding: 20px 24px;

        border-left: 4px solid #c98d97;

        background: #f7efed;

        color: #655957;
      }

      /* VIDEOS */

      .videos {
        margin-top: 58px;
        padding-top: 38px;

        border-top: 1px solid #e9e0dd;
      }

      .videos h2 {
        margin: 0 0 25px;

        color: #292221;

        font-size: 30px;
        line-height: 1.2;
      }

      .video-card {
        margin-bottom: 38px;
      }

      .video-title {
        margin: 0 0 13px;

        color: #332a29;

        font-size: 18px;
        line-height: 1.45;
      }

      .video-frame {
        position: relative;

        width: 100%;

        aspect-ratio: 16 / 9;

        overflow: hidden;

        border-radius: 12px;

        background: #e9e2df;

        box-shadow:
          0 8px 25px
          rgba(56, 37, 34, 0.08);
      }

      .video-frame iframe {
        width: 100%;
        height: 100%;

        border: 0;
      }

      /* RELATED ARTICLES */

      .related {
        margin-top: 60px;
        padding-top: 38px;

        border-top: 1px solid #e9e0dd;
      }

      .related h2 {
        margin: 0 0 25px;

        color: #292221;

        font-size: 30px;
      }

      .related-grid {
        display: grid;

        grid-template-columns:
          repeat(
            3,
            minmax(0, 1fr)
          );

        gap: 18px;
      }

      .related-card {
        display: block;

        padding: 20px;

        background: #ffffff;

        border: 1px solid #eee5e2;
        border-radius: 10px;

        color: #292221;

        text-decoration: none;

        transition:
          transform .2s,
          box-shadow .2s;
      }

      .related-card:hover {
        transform: translateY(-3px);

        box-shadow:
          0 10px 25px
          rgba(56, 37, 34, 0.08);
      }

      .related-category {
        margin: 0 0 9px;

        color: #a15e68;

        font-size: 10px;
        font-weight: 800;

        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .related-title {
        margin: 0;

        font-size: 17px;
        line-height: 1.45;
      }

      /* FAQ */

      .faq {
        margin-top: 60px;
        padding-top: 38px;

        border-top: 1px solid #e9e0dd;
      }

      .faq h2 {
        margin: 0 0 28px;

        color: #292221;

        font-size: 30px;
        line-height: 1.2;
      }

      .faq-item {
        margin-bottom: 28px;

        padding-bottom: 25px;

        border-bottom: 1px solid #eee5e2;
      }

      .faq-question {
        margin: 0 0 10px;

        color: #332a29;

        font-size: 18px;
        line-height: 1.45;
      }

      .faq-answer {
        margin: 0;

        color: #655957;

        font-size: 16px;
        line-height: 1.75;
      }

      /* FOOTER */

      .site-footer {
        padding: 38px 20px;

        border-top: 1px solid #e9e0dd;

        background: #ffffff;

        text-align: center;

        color: #817573;

        font-size: 13px;
      }

      /* TABLET */

      @media (max-width: 800px) {
        .related-grid {
          grid-template-columns:
            repeat(
              2,
              minmax(0, 1fr)
            );
        }

        .article-wrapper {
          padding-top: 45px;
        }
      }

      /* MOBILE */

      @media (max-width: 560px) {
        .header-inner {
          width: calc(100% - 30px);

          min-height: 64px;
        }

        .logo {
          font-size: 20px;
        }

        .back-link {
          font-size: 12px;
        }

        .article-wrapper {
          width: calc(100% - 30px);

          padding: 35px 0 60px;
        }

        h1 {
          font-size: 38px;

          letter-spacing: -1.5px;
        }

        .excerpt {
          font-size: 17px;
        }

        .article-content {
          font-size: 17px;
          line-height: 1.8;
        }

        .article-content :global(h2) {
          font-size: 27px;
        }

        .article-content :global(h3) {
          font-size: 21px;
        }

        .related-grid {
          grid-template-columns: 1fr;
        }

        .videos h2,
        .related h2,
        .faq h2 {
          font-size: 27px;
        }
      }
    </style>
  </head>

  <body>

    <!-- HEADER -->

    <header class="site-header">
      <div class="header-inner">

        <a
          class="logo"
          href="/"
          aria-label="BeautyTrend Daily home"
        >
          BeautyTrend<span>Daily</span>
        </a>

        <a
          class="back-link"
          href="/"
        >
          ← Latest Articles
        </a>

      </div>
    </header>


    <!-- MAIN ARTICLE -->

    <main>

      <article class="article-wrapper">

        <!-- CATEGORY -->

        <a
          class="category"
          href={`/category/${categorySlug}/`}
        >
          {category}
        </a>

        <!-- TITLE -->

        <h1>
          {title}
        </h1>

        <!-- EXCERPT -->

        <p class="excerpt">
          {excerpt || description}
        </p>

        <!-- DATE -->

        <div class="meta">

          Published {formattedDate}

          {formattedUpdatedDate && (
            <>
              · Updated {formattedUpdatedDate}
            </>
          )}

        </div>


        <!-- ARTICLE CONTENT -->

        <div class="article-content">
          <Content />
        </div>


        <!-- VIDEOS -->

        {youtube.length > 0 && (
          <section
            class="videos"
            aria-labelledby="videos-title"
          >

            <h2 id="videos-title">
              Video Tutorials & Inspiration
            </h2>

            {youtube.map((video) => (

              <div class="video-card">

                <h3 class="video-title">
                  {video.title}
                </h3>

                <div class="video-frame">

                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${video.videoId}`}
                    title={video.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>

                </div>

              </div>

            ))}

          </section>
        )}


        <!-- RELATED ARTICLES -->

        {relatedArticles.length > 0 && (
          <section
            class="related"
            aria-labelledby="related-title"
          >

            <h2 id="related-title">
              More From {category}
            </h2>

            <div class="related-grid">

              {relatedArticles.map((related) => (

                <a
                  class="related-card"
                  href={`/articles/${related.id.replace(
                    /\.md$/,
                    ''
                  )}/`}
                >

                  <p class="related-category">
                    {related.data.category}
                  </p>

                  <h3 class="related-title">
                    {related.data.title}
                  </h3>

                </a>

              ))}

            </div>

          </section>
        )}


        <!-- FAQ -->

        {faq.length > 0 && (
          <section
            class="faq"
            aria-labelledby="faq-title"
          >

            <h2 id="faq-title">
              Frequently Asked Questions
            </h2>

            {faq.map((item) => (

              <div class="faq-item">

                <h3 class="faq-question">
                  {item.question}
                </h3>

                <p class="faq-answer">
                  {item.answer}
                </p>

              </div>

            ))}

          </section>
        )}

      </article>

    </main>


    <!-- FOOTER -->

    <footer class="site-footer">

      © {new Date().getFullYear()}
      BeautyTrend Daily.
      All rights reserved.

    </footer>

  </body>
</html>
