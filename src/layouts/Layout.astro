---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = "BeautyTrend Daily - 2026 Hair & Beauty Guides", canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <style>
      :global(*) { box-sizing: border-box; }
      body {
        margin: 0;
        background: #faf8f7;
        color: #202020;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .site-header {
        background: #ffffff;
        border-bottom: 1px solid #eeeeee;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .nav-container {
        max-width: 1160px;
        margin: 0 auto;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        font-size: 22px;
        font-weight: 800;
        color: #111;
        text-decoration: none;
        letter-spacing: -0.5px;
      }
      .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .nav-links a {
        color: #444;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        transition: color 0.2s;
      }
      .nav-links a:hover {
        color: #6366f1;
      }
      .site-footer {
        background: #ffffff;
        border-top: 1px solid #eeeeee;
        padding: 40px 20px;
        text-align: center;
        color: #777;
        font-size: 14px;
        margin-top: 50px;
      }
      .footer-links {
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #555;
        text-decoration: none;
        margin: 0 12px;
        font-size: 13px;
      }
      .footer-links a:hover {
        color: #6366f1;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-container">
        <a href="/" class="logo">BeautyTrend Daily</a>
        <nav class="nav-links">
          <a href="/category/haircuts/">Haircuts</a>
          <a href="/category/hairstyles/">Hairstyles</a>
          <a href="/category/hair-color/">Hair Color</a>
          <a href="/category/mens-haircuts/">Men's</a>
          <a href="/quiz/">Style Quiz</a>
          <a href="/about/">About Us</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/quiz/">Style Quiz</a>
        <a href="/about/">About Us</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
      <p>&copy; {new Date().getFullYear()} BeautyTrend Daily. Reviewed by licensed beauty professionals.</p>
    </footer>
  </body>
</html>